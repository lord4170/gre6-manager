def restore_cmd(args):
    root()
    path = Path(args.path).expanduser().resolve()
    if not path.is_file() or path.stat().st_size > 2 * 1024 * 1024:
        fail("Missing or oversized backup")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        fail("Unreadable backup")
    if data.get("format") != "gre6ctl-backup" or data.get("version") != 1 or not isinstance(data.get("configs"), list):
        fail("Unsupported backup format")
    candidates = [validated_config(d) for d in data["configs"]]
    if len(set(c["name"] for c in candidates)) != len(candidates):
        fail("Backup has duplicate tunnel names")
    with locked():
        installed = all_configs()
        kernel = ipv4_kernel_networks()
        new_names = {c["name"] for c in candidates}
        for cfg in candidates:
            if any(old["name"] == cfg["name"] for old in installed):
                fail(f"Tunnel {cfg['name']} already exists; restore only to a clean manager")
            if get_link(cfg["name"]):
                fail(f"Interface {cfg['name']} already exists")
            assert_available(cfg, installed + [c for c in candidates if c["name"] != cfg["name"]], kernel)
        for cfg in candidates:
            save(cfg)
    print(f"Restored {len(candidates)} configs (not started). Enable individually after checking peer settings.")


