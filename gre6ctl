        fail("Provide an aligned IPv4 /30 network")
    if net.prefixlen != 30 or not any(net.subnet_of(n) for n in RFC1918):
        fail("Specify an RFC1918 /30 network")
    with locked():
        configs = all_configs()
        current = next((c for c in configs if c['name'] == args.exclude), None)
        if args.exclude and current is None:
            fail(f"Tunnel does not exist: {args.exclude}")
        for c in configs:
            if c['name'] != args.exclude and net.overlaps(ipa.IPv4Network(c['subnet'])):
