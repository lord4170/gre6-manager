def doctor_cmd(args):
    cfg = load(args.name)
    name = cfg["name"]
    print(f"GRE6 doctor for {name} ({cfg['subnet']})")
    checks = []
    def check(label, callback):
        try:
            callback()
            print(f"[OK]   {label}")
            checks.append(True)
        except Failure as exc:
            print(f"[FAIL] {label}: {exc}")
            checks.append(False)
    check("iproute2", require_ip)
    check("Local IPv6 assigned", lambda: ensure_local_ipv6(cfg["local6"]))
    check("IPv6 route to peer", lambda: run(["ip", "-6", "route", "get", cfg["peer6"], "from", cfg["local6"]]))
    link = get_link(name)
    check("GRE interface owned by gre6ctl", lambda: None if owned_link(link, name) else fail("interface missing or not managed"))
    if owned_link(link, name):
        check("Interface administratively UP", lambda: None if "UP" in link.get("flags", []) else fail("interface is DOWN"))
        print(run(["ip", "-s", "link", "show", "dev", name], check=False).stdout.rstrip())
    p6 = ping(["ping", "-6", "-c", "2", "-W", "2", cfg["peer6"]]) if shutil.which("ping") else None
    print(f"[{'OK' if p6 and p6.returncode == 0 else 'WARN'}] Public IPv6 ping to peer (ICMPv6 may be filtered)")
    p4 = ping(["ping", "-4", "-I", name, "-c", "2", "-W", "2", cfg["peer4"]]) if shutil.which("ping") and owned_link(link, name) else None
    print(f"[{'OK' if p4 and p4.returncode == 0 else 'WARN'}] Private IPv4 ping to peer")
    if p4 is not None:
        print((p4.stdout or p4.stderr or "").strip()[-700:])
    try:
        kernel = ipv4_kernel_networks(exclude_interface=name)
        assert_available(cfg, all_configs(), kernel, current_name=name)
        print("[OK]   No detected local IPv4 subnet overlap")
    except Failure as exc:
        print(f"[FAIL] IPv4 conflict: {exc}")
        checks.append(False)
    print("\nTroubleshooting: allow IPv6 next-header 47/GRE in host AND provider firewalls;")
    print("check peer config, matching IPv6 endpoints and IP pair, MTU, and ip6_gre module.")
    print("GRE is NOT TCP/UDP port 47. This tool never changes default route, NAT or forwarding.")
    if not all(checks):
        fail("Preflight failed; review diagnostics above")


