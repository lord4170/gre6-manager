def peer_token(cfg):
    peer = dict(cfg)
    peer["local6"], peer["peer6"] = cfg["peer6"], cfg["local6"]
    peer["local4"], peer["peer4"] = cfg["peer4"], cfg["local4"]
    payload = {"format": "gre6ctl-peer", "version": 1, "config": peer}
    raw = json.dumps(payload, separators=(",", ":"), sort_keys=True).encode()
    return TOKEN_PREFIX + base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")


