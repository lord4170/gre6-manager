def make_parser():
    p = argparse.ArgumentParser(description="IPv4 GRE over IPv6 multi-peer tunnel manager (no NAT or default route changes)")
    p.add_argument("--version", action="version", version=f"gre6ctl {VERSION}")
    sp = p.add_subparsers(dest="command")
    def cmd(name, func, help):
        a = sp.add_parser(name, help=help)
        a.set_defaults(func=func)
        return a
    cmd("install", install_cmd, "Install binary and systemd unit")
    cmd("menu", menu_cmd, "Interactive management menu")
    create = cmd("create", create_cmd, "Create tunnel and allocate collision-free /30")
    create.add_argument("name")
    create.add_argument("--local6", required=True)
    create.add_argument("--peer6", required=True)
    create.add_argument("--subnet", help="Explicit /30 network, defaults to automatic pool selection")
    create.add_argument("--local-ip", help="Choose local IPv4; must specify peer-ip too")
    create.add_argument("--peer-ip", help="Choose peer IPv4; must specify local-ip too")
    create.add_argument("--accept-auto", action="store_true",
                        help="Use next safe automatic pair without prompting (for scripts/noninteractive use)")
    create.add_argument("--mtu", type=int, default=1400)
    create.add_argument("--hoplimit", type=int, default=64)
    cx = create.add_mutually_exclusive_group()
    cx.add_argument("--up", action="store_true", help="Activate now")
    cx.add_argument("--enable", action="store_true", help="Activate now and on boot")
    for name, func, help in (("up", up_cmd, "Apply/start tunnel"), ("down", down_cmd, "Stop tunnel"),
                             ("enable", enable_cmd, "Start tunnel and enable at boot"),
                             ("disable", disable_cmd, "Stop and disable at boot"),
                             ("restart", restart_cmd, "Recreate tunnel"),
                             ("status", status_cmd, "Show tunnel details and runtime status"),
                             ("doctor", doctor_cmd, "Diagnose connectivity/ownership/conflicts"),
                             ("export-peer", export_peer_cmd, "Export reversed configuration for peer")):
        a = cmd(name, func, help)
        a.add_argument("name")
    cmd("list", list_cmd, "List configured tunnels")
    cmd("ipam", ipam_cmd, "Show all reserved /30 networks and next available allocation")
    check_subnet = cmd("check-subnet", check_subnet_cmd, "Verify a custom /30 does not conflict locally")
    check_subnet.add_argument("subnet")
    check_subnet.add_argument("--exclude", help="Exclude this managed interface while editing")
    cmd("doctor-all", doctor_all_cmd, "Diagnose every configured tunnel")
    imp = cmd("import-peer", import_peer_cmd, "Import peer token (or --update existing config)")
    imp.add_argument("token", help="gre6ctl1:... peer token")
    imp.add_argument("--name", help="Override interface name for this server")
    imp.add_argument("--update", action="store_true")
    ix = imp.add_mutually_exclusive_group()
    ix.add_argument("--up", action="store_true")
    ix.add_argument("--enable", action="store_true")
    edit = cmd("edit", edit_cmd, "Change IPv4/IPv6/MTU with collision validation and rollback")
    edit.add_argument("name")
    edit.add_argument("--subnet", help="New /30 subnet (automatically selects host pair)")
    edit.add_argument("--local-ip")
    edit.add_argument("--peer-ip")
    edit.add_argument("--local6")
    edit.add_argument("--peer6")
    edit.add_argument("--mtu", type=int)
    edit.add_argument("--hoplimit", type=int)
    rm = cmd("delete", delete_cmd, "Remove a tunnel (keep other tunnels)")
    rm.add_argument("name")
    rm.add_argument("--yes", action="store_true")
    bk = cmd("backup", backup_cmd, "Export all configs to a backup JSON file")
    bk.add_argument("path")
    bk.add_argument("--overwrite", action="store_true")
    rs = cmd("restore", restore_cmd, "Restore backup onto clean manager (not automatically started)")
    rs.add_argument("path")
    return p


def main():
    args = make_parser().parse_args()
    if args.command is None:
        args = argparse.Namespace(command="menu", func=menu_cmd)
    try:
        args.func(args)
    except Failure as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return 1
    except (OSError, KeyboardInterrupt) as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
