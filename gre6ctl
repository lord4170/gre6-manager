def decode_peer(token):
    token = token.strip()
    if not token.startswith(TOKEN_PREFIX) or len(token) > 4096:
        fail("Invalid peer token format/length")
    value = token[len(TOKEN_PREFIX):]
    if not re.fullmatch(r"[A-Za-z0-9_-]+", value):
        fail("Malformed token")
    try:
        raw = base64.urlsafe_b64decode(value + "=" * (-len(value) % 4))
        data = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeError):
        fail("Token is not valid base64 JSON")
    if not isinstance(data, dict) or data.get("format") != "gre6ctl-peer" or data.get("version") != 1:
        fail("Unsupported peer token version")
    return validated_config(data.get("config"))


def import_peer_cmd(args):
    root()
    cfg = decode_peer(args.token)
    if args.name:
        cfg["name"] = valid_name(args.name)
    replace_config(cfg, overwrite=args.update, up=args.up, enable=args.enable)
    print(f"Imported {cfg['name']}: {cfg['local4']} -> {cfg['peer4']}")


def replace_config(cfg, overwrite=False, up=False, enable=False):
    cfg = validated_config(cfg)
    name = cfg["name"]
    with locked():
        allc = all_configs()
        old = next((c for c in allc if c["name"] == name), None)
        if old and not overwrite:
            fail(f"Tunnel {name} exists; use --update to replace it")
        link = get_link(name)
        if old is None and link is not None:
            fail(f"Interface {name} already exists")
        kernel = ipv4_kernel_networks(exclude_interface=name if old else None)
        assert_available(cfg, allc, kernel, current_name=name if old else None)
        if old and link and owned_link(link, name):
            try:
                apply(cfg)
            except Failure:
                try:
                    apply(old)
                except Failure as exc:
                    print(f"CRITICAL: rollback of {name} failed: {exc}", file=sys.stderr)
                raise
        elif link and not owned_link(link, name):
            fail(f"Refusing to overwrite unmanaged interface {name}")
        save(cfg)
    if enable:
        enable_cmd(arg_name(name))
    elif up:
        up_cmd(arg_name(name))


