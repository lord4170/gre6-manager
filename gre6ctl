        for existing, source in ipv4_kernel_networks(exclude_interface=args.exclude):
            if net.overlaps(existing):
                fail(f"COLLISION with {source}: {existing}")
    print(f"AVAILABLE on this server: {net}; usable hosts {list(net.hosts())[0]} and {list(net.hosts())[1]}")
